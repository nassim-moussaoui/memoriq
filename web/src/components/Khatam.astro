---
/**
 * The eight-pointed star (khatam) of the logo and the app onboarding, as a
 * decorative outline. Color comes from `currentColor`.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

function star(cx: number, cy: number, outer: number, inner: number, rot = 0) {
  const pts: string[] = [];
  for (let i = 0; i < 16; i++) {
    const r = i % 2 === 0 ? outer : inner;
    const a = rot + (i * Math.PI) / 8 - Math.PI / 2;
    pts.push(`${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`);
  }
  return `M${pts.join(' L')} Z`;
}
const outer = star(200, 200, 190, 190 * 0.765);
const inner = star(200, 200, 125, 125 * 0.765, Math.PI / 8);
---

<svg class={className} viewBox="0 0 400 400" fill="none" aria-hidden="true">
  <path d={outer} stroke="currentColor" stroke-width="3" stroke-linejoin="round"></path>
  <path d={inner} stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
  <circle cx="200" cy="200" r="52" stroke="currentColor" stroke-width="2"></circle>
</svg>
