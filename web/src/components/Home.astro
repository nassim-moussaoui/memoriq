---
import content from '../generated/app-content.json';
import { useTranslations, type Lang } from '../i18n';
import Icon from './Icon.astro';
import Khatam from './Khatam.astro';
import PhoneMock from './PhoneMock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const app = content[lang];
const qamar = content.verses.qamar17;

// Chart geometry (viewBox 300 x 150): retention 1 at y=20, 0 at y=130.
const W = 300;
const top = 20;
const bottom = 130;
const left = 12;
const right = 288;
const x = (day: number) => left + (day / 30) * (right - left);
const y = (r: number) => top + (1 - r) * (bottom - top);
const decay = (from: number, to: number, stability: number) =>
  Array.from({ length: 31 }, (_, i) => {
    const d = from + ((to - from) * i) / 30;
    return `${x(d).toFixed(1)},${y(Math.exp(-(d - from) / stability)).toFixed(1)}`;
  });
const forgetPath = `M${decay(0, 30, 6).join(' L')}`;
const reviews = [
  { day: 0, s: 4.5 },
  { day: 3, s: 13 },
  { day: 10, s: 30 },
  { day: 22, s: 80 },
];
const spacedPath = `M${reviews.flatMap((r, i) => decay(r.day, reviews[i + 1]?.day ?? 30, r.s)).join(' L')}`;

// French punctuation (? ! : ;) never wraps alone onto the next line.
const nbsp = (text: string) => text.replace(/ ([?!:;])/g, '\u00a0$1');
const featureIcons = ['target', 'bell', 'download', 'chart', 'check', 'sync'] as const;
const titleWords = t.hero.title.split(' ');
const accentWords = t.hero.titleAccent.split(' ');
// Fixed positions (no randomness: identical on every build).
const sparkles = [
  { x: 8, y: 22, size: 10, delay: 0, dur: 6 },
  { x: 18, y: 70, size: 7, delay: 1.2, dur: 7 },
  { x: 30, y: 12, size: 6, delay: 2.4, dur: 5.5 },
  { x: 72, y: 16, size: 9, delay: 0.6, dur: 6.5 },
  { x: 86, y: 58, size: 11, delay: 1.8, dur: 7.5 },
  { x: 92, y: 26, size: 6, delay: 3, dur: 6 },
  { x: 64, y: 80, size: 7, delay: 2, dur: 8 },
];
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
    <Khatam class="hero-star" />
  </div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow reveal">{t.hero.eyebrow}</span>
      <h1 aria-label={`${t.hero.title} ${t.hero.titleAccent}`}>
        <span aria-hidden="true">
          {titleWords.map((w, i) => <span class="w" style={`--d:${120 + i * 90}ms`}>{w}</span>)}
          <br />
          <span class="accent">
            {accentWords.map((w, i) => (
              <span class="w" style={`--d:${120 + (titleWords.length + i) * 90}ms`}>{w}</span>
            ))}
          </span>
        </span>
      </h1>
      <p class="lead reveal">{t.hero.body}</p>
      <div class="hero-ctas reveal">
        <span class="store-badge" aria-disabled="true">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M16.37 1.43c0 1.14-.42 2.2-1.13 3-.82.92-1.97 1.5-3.07 1.41-.14-1.1.43-2.27 1.12-3.03.79-.87 2.13-1.5 3.08-1.38ZM20.5 17.3c-.55 1.27-.82 1.84-1.53 2.96-.99 1.57-2.39 3.52-4.12 3.53-1.54.02-1.94-1-4.03-.99-2.09.01-2.53 1.01-4.07.99-1.73-.02-3.05-1.78-4.04-3.35C-.06 16.07-.35 11.04 1.39 8.37c1.24-1.9 3.19-3.01 5.03-3.01 1.87 0 3.05 1.03 4.6 1.03 1.5 0 2.42-1.03 4.58-1.03 1.64 0 3.37.89 4.6 2.43-4.04 2.22-3.39 8-0.7 9.51Z"
            ></path></svg
          >
          {t.appStoreSoon}
        </span>
        <a class="btn btn-ghost" href="#science">{t.discover}</a>
      </div>
      <p class="free-note reveal">
        <span class="dot" aria-hidden="true"></span>{t.hero.free}
      </p>
    </div>
    <div class="hero-visual reveal">
      <PhoneMock lang={lang} />
    </div>
  </div>
  <div class="container">
    <div class="strip reveal" aria-label={t.strip.join(', ')}>
      <div class="marquee" aria-hidden="true">
        {[0, 1].map(() => (
          <ul>
            {[...t.strip, ...t.strip].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section" id="science">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">{t.science.eyebrow}</span>
      <h2>{t.science.title}</h2>
    </div>
    <div class="science-grid">
      {
        t.science.cards.map((card, i) => (
          <article class="science-card spot reveal" style={`transition-delay:${i * 90}ms`}>
            <div class="chart draw">
              <svg viewBox={`0 0 ${W} 150`} role="img" aria-label={card.title}>
                <line x1={left} x2={right} y1={y(1)} y2={y(1)} class="grid" />
                <line x1={left} x2={right} y1={y(0.5)} y2={y(0.5)} class="grid" />
                <line x1={left} x2={right} y1={bottom} y2={bottom} class="axis" />
                {i === 0 && (
                  <>
                    <path d={`${forgetPath} L${x(30)},${bottom} L${x(0)},${bottom} Z`} class="area" />
                    <path d={forgetPath} class="line" pathLength="1" />
                    <circle cx={x(6 * Math.LN2)} cy={y(0.5)} r="5" class="dot" />
                  </>
                )}
                {i === 1 && (
                  <>
                    <path d={forgetPath} class="line muted" pathLength="1" />
                    <path d={spacedPath} class="line thick" pathLength="1" />
                    {reviews.slice(1).map((r) => (
                      <circle cx={x(r.day)} cy={y(1)} r="4.5" class="dot late" />
                    ))}
                  </>
                )}
                {i === 2 && (
                  <>
                    <rect x="70" width="56" y={y(0.4)} height={bottom - y(0.4)} rx="6" class="bar muted" />
                    <rect x="174" width="56" y={y(0.61)} height={bottom - y(0.61)} rx="6" class="bar" />
                    <text x="98" y={y(0.4) - 10} class="value">40 %</text>
                    <text x="202" y={y(0.61) - 10} class="value strong">61 %</text>
                    <text x="98" y="146" class="label">{t.science.reread}</text>
                    <text x="202" y="146" class="label">{t.science.recall}</text>
                  </>
                )}
              </svg>
            </div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <span class="tag">{card.tag}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section sunna">
  <div class="sunna-bg" aria-hidden="true"><Khatam class="sunna-star" /></div>
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow on-dark">{t.sunna.eyebrow}</span>
      <h2>{t.sunna.title}</h2>
    </div>
    <figure class="verse reveal">
      <p class="arabic verse-ar" lang="ar" aria-label={qamar.ar}>
        {qamar.ar.split(/\s+/).map((w, i) => <span class="vw" style={`--d:${i * 140}ms`}>{w}</span>)}
      </p>
      <figcaption>
        <p class="verse-tr">{app.welcomeVerse}</p>
        <cite>{app.welcomeVerseSource}</cite>
      </figcaption>
    </figure>
    <div class="hadith-grid">
      {
        app.hadiths.map((h, i) => (
          <article class="hadith spot reveal" style={`transition-delay:${i * 80}ms`}>
            <h3>{h.title}</h3>
            <blockquote>{h.quote}</blockquote>
            <p class="source">
              {h.narrator}
              <br />
              <strong>{h.source}</strong>
            </p>
            <p class="method">
              <strong>{t.sunna.methodLabel} :</strong> {h.method}
            </p>
          </article>
        ))
      }
    </div>
    <p class="sunna-body reveal">{app.sunnaBody}</p>
  </div>
</section>

<section class="section" id="how">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">{t.how.eyebrow}</span>
      <h2>{t.how.title}</h2>
    </div>
    <ol class="steps draw">
      {
        t.how.steps.map((step, i) => (
          <li class="step spot reveal" style={`transition-delay:${i * 120}ms; --d:${300 + i * 220}ms`}>
            <span class="step-num" aria-hidden="true"><span>{i + 1}</span></span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section features-section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t.features.eyebrow}</span>
      <h2>{t.features.title}</h2>
    </div>
    <div class="features">
      {
        t.features.items.map((f, i) => (
          <article class="feature spot reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
            <span class="feature-icon" aria-hidden="true">
              <Icon name={featureIcons[i]} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="pricing">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">{t.pricing.eyebrow}</span>
      <h2>{t.pricing.title}</h2>
    </div>
    <div class="plans">
      <article class="plan spot reveal">
        <h3>{t.pricing.free.name}</h3>
        <p class="price">{t.pricing.free.price}</p>
        <p class="period">{t.pricing.free.period}</p>
        <ul>{t.pricing.free.items.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="plan plan-premium spot reveal" style="transition-delay:90ms">
        <span class="plan-badge">{t.pricing.premium.badge}</span>
        <h3>{t.pricing.premium.name}</h3>
        <p class="price">{t.pricing.premium.price}</p>
        <p class="period">{t.pricing.premium.period}</p>
        <p class="alt">{t.pricing.premium.alt}</p>
        <ul>{t.pricing.premium.items.map((item) => <li>{item}</li>)}</ul>
      </article>
    </div>
  </div>
</section>

<section class="section sadaqa" id="sadaqa">
  <div class="container">
    <div class="sadaqa-card reveal">
      <div class="sadaqa-copy">
        <span class="eyebrow gold">{t.sadaqa.eyebrow}</span>
        <h2>{t.sadaqa.title}</h2>
        <p>{t.sadaqa.body}</p>
      </div>
      <ul class="sadaqa-points">
        {t.sadaqa.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="section" id="faq">
  <div class="container faq-wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{t.faq.eyebrow}</span>
      <h2>{t.faq.title}</h2>
    </div>
    <div class="faq">
      {
        t.faq.items.map((item) => (
          <details class="reveal">
            <summary>{nbsp(item.q)}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="final">
  <div class="container">
    <div class="final-card reveal">
      <div class="sparkles" aria-hidden="true">
        {sparkles.map((sp) => (
          <span style={`left:${sp.x}%; top:${sp.y}%; --s:${sp.size}px; --d:${sp.delay}s; --t:${sp.dur}s`}></span>
        ))}
      </div>
      <img src="/brand/memoriq-logo.svg" alt="" width="72" height="72" />
      <h2>{t.final.title}</h2>
      <p>{t.final.body}</p>
      <span class="store-badge on-dark" aria-disabled="true">{t.appStoreSoon}</span>
    </div>
  </div>
</section>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 72px) 0 40px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 85% 20%, color-mix(in srgb, var(--tint) 18%, transparent), transparent 70%),
      radial-gradient(50% 45% at 5% 90%, color-mix(in srgb, var(--gold) 14%, transparent), transparent 70%);
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    opacity: 0.7;
    will-change: transform;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .blob-a {
    width: 420px;
    height: 420px;
    right: -60px;
    top: -80px;
    background: radial-gradient(circle, color-mix(in srgb, var(--tint) 38%, transparent), transparent 68%);
  }
  .blob-b {
    width: 320px;
    height: 320px;
    left: -80px;
    bottom: -60px;
    background: radial-gradient(circle, color-mix(in srgb, var(--gold) 30%, transparent), transparent 68%);
    animation-duration: 22s;
    animation-direction: alternate-reverse;
  }
  @keyframes drift {
    to {
      transform: translate(-60px, 50px) scale(1.15);
    }
  }
  h1 .w {
    display: inline-block;
    margin-inline-end: 0.24em;
    opacity: 0;
    transform: translateY(0.45em) rotate(2deg);
    animation: rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d);
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  h1 .accent .w {
    background: linear-gradient(90deg, var(--tint), color-mix(in srgb, var(--tint) 50%, var(--gold)), var(--tint));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards var(--d),
      shimmer 6s ease-in-out infinite 1.5s;
  }
  @keyframes shimmer {
    50% {
      background-position: 100% 0;
    }
  }
  :global(.hero-star) {
    position: absolute;
    width: 760px;
    right: -220px;
    top: -160px;
    color: var(--tint);
    opacity: 0.09;
    will-change: transform;
    animation: spin 160s linear infinite;
  }
  @keyframes spin-center {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
  }
  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(40px, 6.4vw, 76px);
    font-weight: 850;
    letter-spacing: -0.035em;
  }
  .accent {
    color: var(--tint);
  }
  .lead {
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--muted);
    max-width: 540px;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    font-size: 15px;
    cursor: default;
  }
  .store-badge.on-dark {
    background: #ffffff;
    color: #0b3b2d;
  }
  .free-note {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--tint);
  }
  .free-note .dot {
    flex: none;
    margin-top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tint);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--tint) 20%, transparent);
  }
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  /* Full-bleed: the strip runs edge to edge of the window, not the container. */
  .strip {
    position: relative;
    width: 100vw;
    margin: 56px 0 0 calc(50% - 50vw);
    padding: 20px 0 0;
    border-top: 1px solid var(--border);
    overflow: hidden;
    /* A true transparent fade on both edges, whatever is behind the strip. */
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  /* Two identical halves, each item carrying its own trailing space: moving
     by exactly -50% lands on a copy of the start, so the loop has no seam. */
  .marquee {
    display: flex;
    width: max-content;
    color: var(--muted);
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
    will-change: transform;
    animation: marquee 36s linear infinite;
  }
  .marquee ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee li {
    padding-right: 44px;
  }
  .strip:hover .marquee {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee li::before {
    content: '✓';
    color: var(--tint);
    font-weight: 800;
    margin-right: 8px;
  }

  /* Science */
  .science-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .science-card {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .science-card h3 {
    font-size: 21px;
    font-weight: 800;
  }
  .science-card p {
    color: var(--muted);
    font-size: 16px;
  }
  .tag {
    justify-self: start;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--tint);
    background: var(--tint-soft);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .chart {
    min-width: 0;
    background: var(--bg);
    border-radius: 18px;
    padding: 12px;
    margin-bottom: 6px;
  }
  .chart .grid {
    stroke: var(--surface-2);
    stroke-width: 1;
  }
  .chart .axis {
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .chart .area {
    fill: color-mix(in srgb, var(--tint) 12%, transparent);
    opacity: 0;
    transition: opacity 1s ease 0.6s;
  }
  .chart .line {
    fill: none;
    stroke: var(--tint);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .chart .line.muted {
    stroke: var(--muted);
    opacity: 0.4;
    stroke-width: 2;
    transition-duration: 0.9s;
  }
  .chart .line.thick {
    stroke-width: 3;
    transition-delay: 0.6s;
    transition-duration: 2.2s;
  }
  .chart .dot {
    fill: var(--tint);
    stroke: var(--bg);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 0.3s ease 1.2s;
  }
  .chart .dot.late {
    transition-delay: 2.2s;
  }
  .chart .bar {
    fill: var(--tint);
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform 1s cubic-bezier(0.3, 1.4, 0.5, 1) 0.6s;
  }
  .chart .bar.muted {
    fill: var(--muted);
    opacity: 0.4;
    transition-delay: 0.2s;
  }
  .chart text {
    text-anchor: middle;
    font-family: var(--font);
  }
  .chart .value {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
    opacity: 0;
    transition: opacity 0.4s ease 1.4s;
  }
  .chart .label {
    font-size: 11px;
    fill: var(--muted);
  }
  :global(.draw.is-visible) .line {
    stroke-dashoffset: 0;
  }
  :global(.draw.is-visible) .area,
  :global(.draw.is-visible) .dot,
  :global(.draw.is-visible) .value {
    opacity: 1;
  }
  :global(.draw.is-visible) .bar {
    transform: scaleY(1);
  }

  /* Sunna */
  .sunna {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #0d7e5f 0%, #054c38 100%);
    color: #f1f7f4;
  }
  .sunna-bg :global(.sunna-star) {
    will-change: transform;
    animation: spin-center 200s linear infinite;
    position: absolute;
    width: 900px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: #ffffff;
    opacity: 0.05;
  }
  .sunna .section-head h2 {
    color: #ffffff;
  }
  .eyebrow.on-dark {
    color: #f6d77e;
  }
  .verse {
    position: relative;
    margin: 0 auto clamp(36px, 6vw, 56px);
    max-width: 760px;
    text-align: center;
    display: grid;
    gap: 16px;
  }
  .vw {
    display: inline-block;
    margin-inline-end: 0.28em;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
    transition-delay: var(--d);
  }
  :global(.verse.is-visible) .vw {
    opacity: 1;
    transform: none;
  }
  .verse-ar {
    font-size: clamp(26px, 4.6vw, 44px);
    text-wrap: balance;
    color: #ffffff;
  }
  .verse-tr {
    font-size: clamp(16px, 1.8vw, 18px);
    font-style: italic;
